# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# Adminlarning Telegram ID raqamlari, vergul bilan ajratilgan
ADMIN_IDS=111111111,222222222

# Ma'lumotlar bazasi.
# PostgreSQL (docker-compose ichida):
DB_URL=postgresql+asyncpg://bot:bot_password@db:5432/baholash_bot
# Oddiy variant — SQLite:
# DB_URL=sqlite+aiosqlite:///data/bot.db

# docker-compose dagi PostgreSQL konteyneri uchun
POSTGRES_DB=baholash_bot
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot_password

# Bir foydalanuvchi bitta xodimni necha soatda bir marta baholay oladi (0 = cheklovsiz)
FEEDBACK_COOLDOWN_HOURS=24

# Excel eksportdagi vaqt mintaqasi
TIMEZONE=Asia/Tashkent

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
